{
  "description": "Adds the adversarial second judge and judge calibration thresholds. PASS verdicts from the primary (DeepSeek) judge are re-reviewed by an OpenRouter Claude-family adversarial pass on a different engine so errors decorrelate; adversarial wrapper errors fail closed. Builds on v4.",
  "models": {
    "inner":     "",
    "judge":     "deepseek-v4-flash",
    "evolve":    "",
    "outer":     "",
    "implement": ""
  },
  "engines": {
    "inner":     "codex",
    "judge":     "deepseek",
    "evolve":    "codex",
    "outer":     "codex",
    "implement": "codex"
  },
  "budgets_usd": {
    "inner":     1,
    "judge":     1,
    "evolve":    1,
    "outer":     3,
    "implement": 2
  },
  "timeouts_s": {
    "inner":      600,
    "judge":      180,
    "evolve":     120,
    "outer":      900,
    "implement": 1200
  },
  "adversarial_judge": {
    "enabled": true,
    "engine": "openrouter",
    "model": "anthropic/claude-sonnet-4.6",
    "budget_usd": 1,
    "timeout_s": 180,
    "fail_mode": "closed"
  },
  "judge_calibration": {
    "max_false_pass": 0,
    "min_overall_agreement": 0.8
  },
  "evolution": {
    "max_iter": 3
  },
  "batch": {
    "parallel": 4
  },
  "runner": {
    "auto_promote": {
      "policy": "per_proposal",
      "min_lift_fraction": 0.4,
      "require_zero_holdout_regression": true,
      "revert_on_holdout_regression": true
    },
    "closure_test": {
      "max_targets_per_proposal": 8,
      "min_targets_required": 3,
      "parallel": 3
    },
    "epoch": {
      "max_proposals_per_epoch": 5,
      "stop_on_first_failed_promotion": false,
      "max_cost_usd_per_epoch": 20,
      "max_wall_clock_s_per_epoch": 7200
    },
    "quota_pause": {
      "behavior": "exit",
      "detect_patterns": [
        "You've hit your limit",
        "Rate limit exceeded",
        "rate_limit_exceeded",
        "Anthropic API quota exceeded"
      ],
      "schedule_wakeup_buffer_s": 60
    },
    "experiment": {
      "enabled": false,
      "max_targets": 5,
      "control_inner_mode": "json",
      "treatment_inner_mode": "rule_executor",
      "treatment_normalization_mode": "preserve-executor-boundaries",
      "min_acceptance_delta": 0.0,
      "promote_on_win": false
    },
    "bug_investigate": {
      "enabled": false,
      "min_occurrences": 2,
      "max_proposals_per_epoch": 3,
      "seeds": [
        {
          "id": "orientation_false_rejection",
          "hypothesis": "divide_both_sides rejected Eq(h, 5*R/2) when expecting Eq(5*R/2, h) — mathematically identical, just swapped sides. The validator was rejecting a valid transform because of equation orientation.",
          "evidence_signals": ["VALIDATOR_REJECTED"],
          "affected_rules": ["divide_both_sides"],
          "min_occurrences": 2,
          "reproduction": {
            "from_srepr": "Eq(3*x, 15)",
            "to_srepr": "Eq(5, x)",
            "args": {"divisor": 3},
            "expected": "PASS",
            "actual": "FAIL",
            "proposed_change": "Accept swapped orientation in validator (to_expr.lhs == expected_rhs and to_expr.rhs == expected_lhs is a valid result)",
            "negative": {
              "from_srepr": "Eq(3*x, 15)",
              "to_srepr": "Eq(x, 6)",
              "args": {"divisor": 3}
            }
          }
        },
        {
          "id": "fused_subst_simplify",
          "hypothesis": "Substitution and simplification are being fused into single graph edges, causing one_rule_per_edge judge rejections.",
          "evidence_signals": ["one_rule_per_edge"],
          "affected_rules": ["substitute_value", "simplify_expression"],
          "min_occurrences": 2
        }
      ]
    },
    "state_file": "derivations/_epoch_state.json"
  }
}
